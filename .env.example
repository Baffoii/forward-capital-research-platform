# Copy this file to .env and fill in your own values. Never commit real credentials.

# Supabase project — database AND sign-in.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# The same two values again, with a VITE_ prefix so the browser bundle can see
# them. Vite only exposes variables starting with VITE_, and the sign-in flow
# runs in the browser. The anon key is public by design — it names the project,
# it doesn't grant access. Access is decided server-side against the three-email
# allowlist in shared/team.ts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct Postgres connection string, only needed for the `db:push:*` scripts.
# The anon key above cannot run DDL. Supabase dashboard > Project Settings >
# Database > Connection string > URI. Leave unset if you apply the generated
# migrations by hand in the SQL editor instead.

# Shared secret required in the `x-admin-token` header for /api/admin/* routes
# (ingest, sync-all, recompute-all, and the scheduled watcher jobs). Generate
# any random string. Scheduled jobs have no Google account, so this is how they
# authenticate — it is not a substitute for a human signing in.
INGEST_ADMIN_TOKEN=replace-with-a-random-string

# Direct Postgres connection string, only needed for the `db:push:*` scripts.
# The anon key above cannot run DDL. Supabase dashboard > Project Settings >
# Database > Connection string > URI. Leave unset if you apply the generated
# migrations/*.sql by hand in the SQL editor instead.
DATABASE_URL=

# ── Notifications ────────────────────────────────────────────────────────
# EMAIL IS NOT LIVE YET. Until EMAIL_ENABLED is "true" AND EMAIL_API_KEY is
# set, the watcher writes each notification to the database and prints the
# full body to the server log instead of sending it. That is intentional: the
# whole pipeline can be exercised and the wording criticised before anything
# reaches an inbox. See the header comment in server/watcher/dispatch.ts for
# how to turn it on.
EMAIL_ENABLED=false
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=Forward Capital <alerts@example.com>

# ── Sorting messy handoff notes (optional) ───────────────────────────────
# Without this key, handoff packets save with the note exactly as typed and
# the sorted fields stay blank for someone to fill in by hand. The feature
# works either way — the sorting is a convenience, not a dependency.
# See server/handoffs/structure.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Financial Modeling Prep ──────────────────────────────────────────────
# Server-side only, never VITE_-prefixed. The free tier serves only five of
# our thirteen companies (NVDA AMZN MSFT AMD INTC); the rest, including VRT
# and GEV, return a permission error and their price triggers stay dormant.
# See the header of server/fmp/client.ts for the full probe result.
FMP_API_KEY=

# ── Discord ──────────────────────────────────────────────────────────────
# Two webhooks on purpose. Urgent carries kill criteria, pre-commitments and
# handoff escalations; digest carries the weekly five and journal resurfacing.
# Mixing them trains everyone to skim both at the weekly rate. Neither is
# required — with both unset, notifications log server-side instead.
DISCORD_WEBHOOK_URGENT=
DISCORD_WEBHOOK_DIGEST=
