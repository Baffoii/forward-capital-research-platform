# Copy this file to .env and fill in your own values. Never commit real credentials.

# Supabase project (Database only — see README for setup)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Shared secret required in the `x-admin-token` header for /api/admin/* routes
# (ingest, sync-all, recompute-all). Generate any random string.
INGEST_ADMIN_TOKEN=replace-with-a-random-string

# Research Bot (server-side only). Uses the Responses API with web search.
OPENAI_API_KEY=your-openai-api-key
# Optional quality/cost override. Defaults to gpt-5.6-terra.
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
