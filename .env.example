# Copy this file to .env and fill in your own values. Never commit real credentials.

# Supabase project (Database only — see README for setup)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct Postgres connection string, only needed for `npm run db:push:constraints`.
# The anon key above cannot run DDL. Supabase dashboard > Project Settings >
# Database > Connection string > URI. Leave unset if you apply
# migrations-constraints/*.sql by hand in the SQL editor instead.
DATABASE_URL=

# Shared secret required in the `x-admin-token` header for /api/admin/* routes
# (ingest, sync-all, recompute-all). Generate any random string.
INGEST_ADMIN_TOKEN=replace-with-a-random-string
