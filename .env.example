# Copy this file to .env and fill in your own values. Never commit real credentials.

# Supabase project (Database only — see README for setup)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Shared secret required in the `x-admin-token` header for /api/admin/* routes
# (ingest, sync-all, recompute-all). Generate any random string.
INGEST_ADMIN_TOKEN=replace-with-a-random-string

# Alpaca paper-trading account (Paper Trading tab). Server-side only — never sent to the browser.
# Create keys at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_BASE_URL=https://data.alpaca.markets/v2
ALPACA_API_KEY_ID=your-alpaca-paper-key-id
ALPACA_API_SECRET_KEY=your-alpaca-paper-secret-key
